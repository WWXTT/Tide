<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TideSim：三套预组无头对战模拟（2026-11-04 新建，替代旧的 Tools/AI 自动对战窗口）。

    原则：
      · 规则=资产仓当前 CardCore（与游戏同一份源码，不复制、不使用旧驱动）；
      · 策略=按预组名显式绑定（红→RedAggro / 绿→GreenRamp / 蓝→BlueControl），不走 AutoMatch 猜测；
      · 技能/衍生物=从预组 JSON 的 skillCardId/tokenBindings 传入 InitGame；
      · 每局独立 seed，可复现；逐局日志打印双方卡组/技能/策略，detail 模式打印每回合与每次出牌；
      · 响应窗策略（AiStrategyRegistry + AiResponder）与 End→Standby 补泵（CheckPhaseTransition）同真实驱动。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TideSim</AssemblyName>
    <RootNamespace>TideSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="UniTask" Version="2.5.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Assets\Scripts\HotUpdate\CardCore\**\*.cs" LinkBase="Shared\CardCore" />
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\SimpleAI.cs" Link="Shared\SynergyUI\SimpleAI.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\AiStrategy.cs" Link="Shared\SynergyUI\AiStrategy.cs" />
    <!-- 2026-11-09 拆分：AiStrategy 三主题策略各自成文件（类型名不变）。 -->
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\RedAggroStrategy.cs" Link="Shared\SynergyUI\RedAggroStrategy.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\GreenRampStrategy.cs" Link="Shared\SynergyUI\GreenRampStrategy.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\BlueControlStrategy.cs" Link="Shared\SynergyUI\BlueControlStrategy.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\AiDuelRunner.cs" Link="Shared\SynergyUI\AiDuelRunner.cs" />
    <!-- 教学预设场面数据类+静默注入器（2026-11-04 教学场景回归）：tutorial-scenario 入口直接复用
         教学侧同一份 TutorialScenarioSeeder，不复制注入逻辑（盘面口径与教学模式零漂移）。 -->
    <Compile Include="..\Assets\Scripts\HotUpdate\AI\TutorialScenario.cs" Link="Shared\SynergyUI\TutorialScenario.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\CardCatalog.cs" Link="Shared\SynergyUI\CardCatalog.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\CardDataPaths.cs" Link="Shared\SynergyUI\CardDataPaths.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\DeckTokenSupport.cs" Link="Shared\SynergyUI\DeckTokenSupport.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\DeckData.cs" Link="Shared\SynergyUI\DeckData.cs" />
    <!-- 卡组校验单源（2026-11-13 deck-rule）：效果组合合法性硬约束随卡组面走，不在 TideSim 复制逻辑 -->
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\DeckCompositionValidator.cs" Link="Shared\SynergyUI\DeckCompositionValidator.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\ContentHasher.cs" Link="Shared\SynergyUI\ContentHasher.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\EffectGraphData.cs" Link="Shared\SynergyUI\EffectGraphData.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\KeywordCatalog.cs" Link="Shared\SynergyUI\KeywordCatalog.cs" />
    <Compile Include="..\Assets\Scripts\HotUpdate\UI\Data\ColorFilter.cs" Link="Shared\SynergyUI\ColorFilter.cs" />
    <Compile Include="..\TideServer\HeadlessAiShims.cs" Link="Shared\TideServer\HeadlessAiShims.cs" />
  </ItemGroup>

</Project>
