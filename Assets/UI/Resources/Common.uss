/* Synergy 通用样式 —— 深色实用主题。集中管理颜色/间距/控件外观，各界面共用。 */

/* ---------- 布局根 ---------- */
.screen {
    flex-grow: 1;
    background-color: rgb(24, 27, 33);
    padding: 16px;
}

.screen__title {
    font-size: 28px;
    color: rgb(238, 240, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.screen__subtitle {
    font-size: 14px;
    color: rgb(150, 156, 168);
    margin-bottom: 16px;
}

/* ---------- 工具栏 ---------- */
.toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap; /* 2026-09-14：控件过多时换行而非互相挤压遮挡（min-width 保形） */
}

.spacer {
    flex-grow: 1;
}

/* ---------- 面板 ---------- */
.panel {
    background-color: rgb(33, 37, 45);
    border-radius: 8px;
    padding: 12px;
    border-width: 1px;
    border-color: rgb(46, 51, 61);
}

.panel__header {
    font-size: 16px;
    color: rgb(210, 215, 224);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

/* ---------- 按钮 ---------- */
.btn {
    height: 36px;
    min-width: 96px;
    padding-left: 16px;
    padding-right: 16px;
    margin: 4px;
    border-radius: 6px;
    border-width: 0;
    background-color: rgb(54, 60, 72);
    color: rgb(225, 229, 236);
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: rgb(68, 76, 90);
}

.btn:active {
    background-color: rgb(44, 49, 59);
}

.btn--primary {
    background-color: rgb(64, 132, 240);
    color: rgb(255, 255, 255);
}

.btn--primary:hover {
    background-color: rgb(86, 150, 250);
}

.btn--block {
    width: 280px;
    height: 48px;
    font-size: 16px;
}

.btn--danger {
    background-color: rgb(196, 72, 72);
    color: rgb(255, 255, 255);
}

/* ---------- 列表行 / 卡片 ---------- */
.list {
    flex-grow: 1;
    background-color: rgb(28, 31, 38);
    border-radius: 6px;
    padding: 4px;
}

.list-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 10px;
    padding-right: 6px;
    margin-bottom: 4px;
    border-radius: 5px;
    background-color: rgb(40, 45, 55);
}

.list-row:hover {
    background-color: rgb(50, 56, 68);
}

.list-row__name {
    flex-grow: 1;
    color: rgb(225, 229, 236);
    font-size: 14px;
}

.list-row__meta {
    color: rgb(150, 156, 168);
    font-size: 12px;
    margin-right: 8px;
}

.cost-badge {
    min-width: 26px;
    height: 24px;
    border-radius: 12px;
    background-color: rgb(64, 132, 240);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

/* ---------- 表单字段 ---------- */
.field-label {
    color: rgb(180, 186, 198);
    font-size: 13px;
    margin-right: 8px;
}

.text-input {
    min-width: 200px;
    margin-right: 8px;
}

/* ---------- 提示条 ---------- */
.toast {
    color: rgb(120, 210, 140);
    font-size: 13px;
    margin-left: 8px;
}

/* ---------- 两栏布局 ---------- */
.columns {
    flex-direction: row;
    flex-grow: 1;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.column:last-child {
    margin-right: 0;
}

/* ---------- 效果合成：步骤卡 / 子序列 / 小数值输入 ---------- */
.step-card {
    margin-bottom: 8px;
}

.sub-list {
    background-color: rgb(28, 31, 38);
    border-radius: 6px;
    padding: 6px;
    margin-bottom: 8px;
}

.int-input {
    min-width: 90px;
    margin-right: 8px;
}

/* ---------- 精修：60/40 两栏 + 选中态 ---------- */
.column--left {
    flex-grow: 6;
}

.column--right {
    flex-grow: 4;
}

.list-row--selected {
    background-color: rgb(46, 78, 132);
    border-width: 1px;
    border-color: rgb(86, 150, 250);
}

.btn--mini {
    height: 26px;
    min-width: 30px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 12px;
    margin: 2px;
}

.sub-item {
    margin-bottom: 6px;
    padding: 8px;
}

.hint {
    color: rgb(140, 146, 158);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

/* ---------- 颜色过滤 chip + 色点 ---------- */
.filter-bar {
    flex-wrap: wrap;
}

.chip {
    height: 28px;
    min-width: 44px;
    padding-left: 12px;
    padding-right: 12px;
    margin: 3px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(60, 66, 78);
    background-color: rgb(40, 45, 55);
    color: rgb(210, 215, 224);
    font-size: 12px;
    -unity-font-style: bold;
}

.chip--active {
    border-width: 2px;
    border-color: rgb(238, 240, 245);
}

.chip--red {
    background-color: rgb(150, 56, 56);
    color: rgb(255, 235, 235);
}

.chip--blue {
    background-color: rgb(52, 84, 150);
    color: rgb(232, 240, 255);
}

.chip--green {
    background-color: rgb(52, 120, 72);
    color: rgb(232, 255, 240);
}

.chip--gray {
    background-color: rgb(80, 86, 98);
    color: rgb(232, 235, 240);
}

.chip--all {
    background-color: rgb(54, 60, 72);
    color: rgb(225, 229, 236);
}

.color-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 8px;
    background-color: rgb(80, 86, 98);
    /* 细亮描边：深色主题上黑色圆点靠描边与背景区分（2026-09-21） */
    border-width: 1px;
    border-color: rgba(235, 240, 245, 0.45);
}

/* 圆点亮色覆盖（2026-09-21）：chip--* 的基色为大面积按钮设计（暗色），
   12-14px 圆点上红/蓝与黑/灰不可辨——圆点场景单独提亮加饱和。 */
.color-dot.chip--red {
    background-color: rgb(232, 82, 82);
}

.color-dot.chip--blue {
    background-color: rgb(84, 138, 242);
}

.color-dot.chip--green {
    background-color: rgb(74, 200, 108);
}

.color-dot.chip--gray {
    background-color: rgb(148, 154, 166);
}

.color-dot.chip--black {
    background-color: rgb(20, 21, 26);
}

.color-dot.chip--white {
    background-color: rgb(240, 243, 248);
}

/* ---------- 对战界面 ---------- */
.battle {
    flex-direction: column;
}

.battle-zone {
    background-color: rgb(33, 37, 45);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(46, 51, 61);
    padding: 8px;
    margin-bottom: 8px;
}

.battle-zone--opponent {
    border-color: rgb(120, 70, 70);
}

.battle-zone--self {
    border-color: rgb(64, 100, 160);
}

.battle-zone__bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.battle-side__name {
    font-size: 15px;
    color: rgb(210, 215, 224);
    -unity-font-style: bold;
    margin-right: 12px;
}

.battle-meta {
    color: rgb(180, 186, 198);
    font-size: 13px;
    margin-right: 12px;
}

.life-badge {
    min-width: 64px;
    height: 26px;
    border-radius: 13px;
    background-color: rgb(196, 72, 72);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 12px;
    padding-left: 10px;
    padding-right: 10px;
}

.battle-row__label {
    color: rgb(140, 146, 158);
    font-size: 11px;
    margin-bottom: 2px;
}

.card-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 84px;
    background-color: rgb(28, 31, 38);
    border-radius: 6px;
    padding: 4px;
    margin-bottom: 6px;
}

.battle-card {
    width: 96px;
    height: 74px;
    margin: 3px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(60, 66, 78);
    background-color: rgb(44, 49, 59);
    padding: 4px;
    align-items: flex-start;
}

.battle-card:hover {
    border-color: rgb(86, 150, 250);
    background-color: rgb(52, 58, 70);
}

.battle-card--back {
    background-color: rgb(40, 38, 50);
    border-color: rgb(70, 64, 90);
    align-items: center;
    justify-content: center;
}

.battle-card--tapped {
    background-color: rgb(36, 40, 48);
    border-color: rgb(50, 54, 64);
}

.battle-card__name {
    color: rgb(225, 229, 236);
    font-size: 11px;
    white-space: normal;
    -unity-font-style: bold;
}

.battle-card__stats {
    color: rgb(150, 156, 168);
    font-size: 11px;
    margin-top: 2px;
}

.battle-center {
    background-color: rgb(28, 31, 38);
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 8px;
}

.phase-bar {
    font-size: 15px;
    color: rgb(238, 240, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.battle-actions {
    margin-bottom: 0;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 16, 0.72);
    align-items: center;
    justify-content: center;
}

.overlay__panel {
    width: 420px;
    background-color: rgb(33, 37, 45);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(64, 70, 84);
    padding: 16px;
}



/* ---------- 合成器重做（2026-09-14）：拖拽槽位 / 模式条 / 黑白色 chip ---------- */

.chip--black {
    background-color: rgb(28, 30, 36);
    color: rgb(225, 229, 236);
    border-color: rgb(90, 95, 108);
}

.chip--white {
    background-color: rgb(210, 214, 222);
    color: rgb(30, 32, 38);
}

.mode-bar {
    margin-bottom: 6px;
}

.mode-chip {
    margin-right: 6px;
    padding: 4px 12px;
    border-radius: 6px;
    background-color: rgb(54, 60, 72);
    color: rgb(200, 205, 214);
    border-width: 1px;
    border-color: rgb(64, 70, 84);
}

.mode-chip--active {
    background-color: rgb(58, 84, 120);
    color: rgb(235, 240, 250);
    border-color: rgb(120, 150, 200);
    border-width: 2px;
}

.slot-area {
    min-height: 180px;
}

.drop-slot {
    border-width: 2px;
    border-color: rgb(64, 70, 84);
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(24, 27, 33, 0.6);
}

.drop-slot--trunk {
    border-color: rgb(110, 130, 170);
}

.drop-slot--reward {
    border-color: rgb(120, 150, 110);
}

/* 槽位选中态（2026-09-21 交互重做：右侧点击=替换选中槽的原子） */
.drop-slot--selected {
    border-color: rgb(126, 168, 255);
    border-width: 2px;
    background-color: rgba(70, 110, 170, 0.32);
}

/* 下拉菜单拉宽 + 去横向滚动（2026-09-21）：弹窗挂面板层——由 UIManager 面板级注入本表生效 */
.unity-generic-menu {
    min-width: 280px;
    max-width: none;
    /* 限高纵向滚动（2026-09-22）：触发时机 27 项全长过高——300px 约见一半，
       超出部分由弹窗内 ScrollView 出纵向滚动条；持续/目标域等短菜单不受影响 */
    max-height: 300px;
}

.unity-generic-menu .unity-scroller--horizontal {
    display: none;
}

/* 字段标签可读性（2026-09-21）：IntegerField/Slider/Dropdown 的 label 默认色与深底混淆 */
.int-input .unity-base-field__label,
.text-input .unity-base-field__label {
    color: rgb(205, 210, 220);
}

.library-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 4px 6px;
}

.color-filter-chip {
    min-width: 40px;
}

/* 单行省略（2026-09-22）：效果表行只留一行描述——超宽截断出省略号，不再纵向换行 */
.single-line {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 不可编辑关键词行（2026-09-22）：攻击/守卫固定展示（不可组合/修改）——降透明度示只读 */
.library-row--locked {
    opacity: 0.6;
}

/* ============ 2026-09-23：校验红框闪烁 / 属性描述条 / 六向箭头三角选择器 ============ */

/* 校验区（不合规设置）：闪烁红边框——根类 .zones-flash-off 由界面 500ms 翻转实现双态闪烁；
   放文件末尾保证对 .drop-slot--selected 等同特异度边框规则的覆盖 */
.zone--invalid {
    border-width: 2px;
    border-color: rgb(235, 82, 82);
}

.zones-flash-off .zone--invalid {
    border-color: rgba(235, 82, 82, 0.28);
}

/* 校验区红字提示（区域内部追加） */
.hint--error {
    color: rgb(242, 126, 126);
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 0;
    white-space: normal;
}

/* 属性描述条（2026-09-23）：控件说明选中才出现——不常驻 */
.desc-strip {
    min-height: 30px;
    color: rgb(172, 202, 238);
    font-size: 11px;
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 0;
    border-width: 1px;
    border-color: rgb(52, 62, 80);
    border-radius: 6px;
    padding: 4px 8px;
    background-color: rgba(36, 44, 60, 0.5);
}

/* 六向三角选择器（2026-09-23 光环箭头）：三角形围成一圈，选中变蓝白。
   三角形=CSS 边框三角（0 尺寸+三边框）；arrow-hit=更大的透明点击格（旋转朝外） */
.arrow-picker {
    width: 132px;
    height: 132px;
    align-self: center;
    margin-top: 6px;
    margin-bottom: 2px;
}

.arrow-hit {
    position: absolute;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
}

.arrow-tri {
    width: 0;
    height: 0;
    margin-top: -8px; /* 边框三角自 content 点向下展开——上提一半使其绕圈心居中 */
    border-left-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 16px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgb(96, 104, 118);
    transition-property: border-bottom-color;
    transition-duration: 0.15s;
}

.arrow-hit:hover .arrow-tri {
    border-bottom-color: rgb(140, 152, 170);
}

/* 选中=蓝白 */
.arrow-hit--on {
    background-color: rgba(90, 160, 230, 0.16);
}

.arrow-hit--on .arrow-tri {
    border-bottom-color: rgb(148, 212, 255);
}

/* ============ 2026-09-24：对战 HUD 重做（格子化战场 + 战报侧栏） ============ */

.battle-screen {
    flex-grow: 1;
}

.battle-main {
    flex-direction: row;
    flex-grow: 1;
}

.battle-board {
    flex-grow: 1;
    flex-direction: column;
}

/* 玩家信息栏（对手在上=红调，我方在下=蓝调） */
.battle-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 31, 38);
    border-radius: 8px;
    border-width: 1px;
    padding: 4px 8px;
    margin-bottom: 4px;
}

.battle-bar--opponent {
    border-color: rgb(120, 70, 70);
}

.battle-bar--self {
    border-color: rgb(64, 100, 160);
}

/* 技能卡小片（FieldZone 永续魔法）：名+费用+横置态 */
.skill-chip {
    min-width: 88px;
    max-width: 150px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(120, 100, 60);
    background-color: rgb(46, 42, 34);
    padding: 3px 6px;
    margin-right: 12px;
    color: rgb(226, 216, 190);
    font-size: 11px;
    white-space: normal;
}

.skill-chip--tapped {
    opacity: 0.45;
}

/* 棋盘行：9 格横排；odd-r 六角——奇数行右偏半格（格宽 96 的一半） */
.hex-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.hex-row--odd {
    margin-left: 48px;
}

/* 单位格底座（常驻可见的空格；有卡时内嵌 .battle-card） */
.hex-cell {
    position: relative;
    width: 96px;
    height: 74px;
    margin: 3px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(38, 42, 51);
    background-color: rgb(26, 29, 36);
    padding: 0;
}

.hex-cell--land {
    width: 76px;
    height: 62px;
}

/* 地牌格内卡（小卡） */
.land-tokens {
    color: rgb(170, 176, 188);
    font-size: 10px;
    white-space: normal;
}

/* 箭头指示点：卡面六向光环（odd-r 邻接方向）；亮起=该向有箭头 */
.arrow-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
}

.arrow-dot--on {
    background-color: rgb(148, 212, 255);
    box-shadow: 0 0 4px rgb(148, 212, 255);
}

/* 六方向定位（相对格子；单位格 96×74） */
.arrow-dot--ne { top: 2px; left: 82px; }
.arrow-dot--e  { top: 32px; left: 84px; }
.arrow-dot--se { bottom: 2px; left: 82px; }
.arrow-dot--sw { bottom: 2px; left: 4px; }
.arrow-dot--w  { top: 32px; left: 3px; }
.arrow-dot--nw { top: 2px; left: 4px; }

/* 战报侧栏 */
.battle-log {
    width: 260px;
    margin-left: 8px;
}

.battle-log__list {
    flex-grow: 1;
}

.log-line {
    color: rgb(176, 182, 194);
    font-size: 11px;
    white-space: normal;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(46, 51, 61, 0.5);
}

.log-line--turn {
    color: rgb(148, 212, 255);
    -unity-font-style: bold;
    margin-top: 4px;
}

.log-line--combat {
    color: rgb(235, 150, 130);
}

.log-line--system {
    color: rgb(120, 200, 150);
}

/* 我方手牌条 */
.battle-hand {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgb(28, 31, 38);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(46, 51, 61);
    padding: 4px;
    margin-top: 4px;
    min-height: 84px;
}

.battle-center__top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

/* 发动区卡（中栏右侧摘要用小片） */
.activation-chip {
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(96, 104, 118);
    background-color: rgb(40, 38, 50);
    color: rgb(210, 205, 224);
    font-size: 11px;
    padding: 2px 6px;
    margin-left: 6px;
}
