<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <ui:VisualElement name="root" class="screen">
        <!-- 顶部工具栏：返回/标题 + 右侧双按钮（读取原子表 / 读取效果表） -->
        <ui:VisualElement class="toolbar">
            <ui:Button name="btn-back" text="返回" class="btn" />
            <ui:Label text="效果合成" class="screen__title" style="margin-bottom: 0; margin-left: 8px;" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="btn-reload-atoms" text="读取原子表" class="btn" />
            <ui:Button name="btn-load-effects" text="读取效果表" class="btn" />
        </ui:VisualElement>

        <!-- 效果元信息：自动名（只读）+ 触发方式 + 触发时机（中文，主动时隐藏）+ 保存 -->
        <ui:VisualElement class="toolbar">
            <ui:Label text="效果名" class="field-label" />
            <ui:Label name="lbl-effect-name" text="（自动）" class="field-label" style="color: rgb(120, 210, 140); font-size: 15px; -unity-font-style: bold;" />
            <ui:Label name="lbl-effect-cost" text="费用：—" class="field-label" style="color: rgb(230, 190, 120); margin-left: 10px;" />
            <ui:Label text="触发方式" class="field-label" style="margin-left: 12px;" />
            <ui:DropdownField name="dropdown-activation" class="text-input" />
            <ui:Label text="触发时机" name="lbl-timing" class="field-label" style="margin-left: 12px;" />
            <ui:DropdownField name="dropdown-timing" class="text-input" />
            <ui:Button name="btn-save" text="保存" class="btn btn--primary" />
        </ui:VisualElement>
        <ui:Label name="lbl-activation-hint" text="" class="hint" style="margin-top: -8px;" />

        <!-- 两栏：左=编辑栏（模式条+槽位+效果设置），右=双模式展示区（原子库 / 效果表） -->
        <ui:VisualElement class="columns">
            <ui:VisualElement class="column column--left panel">
                <ui:VisualElement name="mode-bar" class="toolbar mode-bar" />
                <ui:ScrollView name="slot-area" class="list slot-area" />
                <!-- 属性描述条（2026-09-23）：可编辑控件的说明选中才在此出现——不常驻，拓宽可用区域 -->
                <ui:Label name="lbl-prop-desc" text="" class="desc-strip" style="display: none;" />
            </ui:VisualElement>
            <ui:VisualElement class="column column--right panel">
                <!-- 筛选栏（2026-09-22 两模式共用）：效果分类 + 近似搜索
                     （原子库=表行中文名；效果表=内含原子名并集；检索对效果表额外含 id∪简称） -->
                <ui:VisualElement class="toolbar filter-bar">
                    <ui:Label text="效果分类：" class="field-label" />
                    <ui:DropdownField name="dropdown-filter-type" class="text-input" />
                    <ui:Label text="近似搜索" class="field-label" style="margin-left: 12px;" />
                    <ui:TextField name="field-filter-name" class="text-input" />
                </ui:VisualElement>
                <!-- 效果表模式（点击效果=载入左侧编辑，保存覆盖）——行=色点+名+id 单行（2026-09-22） -->
                <ui:ScrollView name="list-effects" class="list" style="flex-grow: 1; flex-basis: 0;" />
                <!-- 原子库模式（2026-09-23 单列：关键词 Grant 行随原子同列，锁定行直接隐藏——不再分两段） -->
                <ui:VisualElement name="atom-panel" style="flex-grow: 1;">
                    <!-- 选中槽上下文（2026-09-22 五轮）：库按选中槽过滤——标签动态显示当前过滤口径 -->
                    <ui:Label name="lbl-lib-context" text="" class="hint" style="margin-bottom: 2px;" />
                    <ui:ScrollView name="library-list" class="list" style="flex-grow: 1; flex-basis: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 底部左侧：提示信息 -->
        <ui:VisualElement class="toolbar" style="margin-bottom: 0; margin-top: 4px;">
            <ui:Label name="lbl-toast" text="" class="toast" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
